# --- Local notes & context (intentionally NOT version-controlled) ---
/SPAR_CONTEXT.md
/docs/
# any stray context/notes markdown at the repo root
/*.context.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Eval outputs ---
results.json

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- secrets / local env ---
.env
.env.local

# --- eval run outputs / caches (generated; never committed) ---
.eval_cache*/
/runs/
/runs_*/
